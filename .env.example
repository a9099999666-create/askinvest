# База (обязательно; без значения в коде).
# На Vercel как у SHARENTA: Neon, переменная DATABASE_URL или POSTGRES_URL.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/askinvest
POSTGRES_URL=

# Приложение
APP_URL=http://localhost:3000
SESSION_SECRET=

# Первый владелец: npm run seed:owner (оба обязательны)
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Владелец

# Демо-данные только локально
ALLOW_DEMO_SEED=false

# Тестовый адаптер мессенджеров (локально). В production нужен ещё TEST_CHANNEL_SECRET.
ENABLE_TEST_CHANNEL=false
TEST_CHANNEL_SECRET=

# Медиа: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# MAX
MAX_BOT_TOKEN=
MAX_BOT_LINK=
MAX_WEBHOOK_SECRET=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

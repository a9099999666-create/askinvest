# База
DATABASE_URL=postgres://askinvest:askinvest@127.0.0.1:5432/askinvest

# Приложение
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-long-random-string

# Первый владелец (npm run seed:owner)
OWNER_EMAIL=owner@askinvest.local
OWNER_PASSWORD=askinvest-owner
OWNER_NAME=Владелец

# Демо-данные только локально: ALLOW_DEMO_SEED=true npm run seed:demo
ALLOW_DEMO_SEED=false

# Медиа: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
# S3-совместимое хранилище (опционально)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# MAX
MAX_BOT_TOKEN=
MAX_BOT_LINK=
MAX_WEBHOOK_SECRET=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
